# Managed by Ansible
server {
    listen 443 ssl;
    server_name {{ authentik_public_fqdn }} {{ vm_fqdn | default('') }} {{ ansible_host | default(vm_ip | default('')) }};

    ssl_certificate     {{ acme_cert_fullchain_file }};
    ssl_certificate_key {{ acme_cert_key_file }};

    client_max_body_size 100m;

    location / {
        proxy_pass http://{{ authentik_http_bind_address }}:{{ authentik_http_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}
